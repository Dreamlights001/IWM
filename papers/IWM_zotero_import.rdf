  <rdf:Description rdf:about="urn:iwm:survey:2026-11-09:P40:note">
    <rdf:type rdf:resource="http://purl.org/net/biblio#Memo" />
    <rdf:value>&lt;h2&gt;P40 · GRUtopia: Dream General Robots in a City at Scale&lt;/h2&gt;&lt;p&gt;&lt;strong&gt;贡献：&lt;/strong&gt; GRUtopia 将多类场景、NPC 任务系统和多机器人基准组织为大规模交互环境。&lt;/p&gt;&lt;p&gt;&lt;strong&gt;论文证据范围：&lt;/strong&gt; 服务环境与移动／操作任务，强调场景多样性。&lt;/p&gt;&lt;p&gt;&lt;strong&gt;工厂迁移边界（本报告分析）：&lt;/strong&gt; 城市规模几何场景并不等于工厂生产流程、设备工艺或多设备联合动力学。&lt;/p&gt;&lt;p&gt;&lt;strong&gt;阅读定位：&lt;/strong&gt; 摘要；GRScenes / GRResidents / GRBench&lt;/p&gt;&lt;p&gt;调研日：2026-11-09；报告未复现论文实验。归档版本：v1。来源：https://arxiv.org/abs/2407.10943&lt;/p&gt;&lt;p&gt;固定版本 PDF：https://arxiv.org/pdf/2407.10943v1；SHA-256：a9313365280d8b7f0e96880ee058af119c8ed5953a05753bda6c38ed161190db&lt;/p&gt;</rdf:value>
  </rdf:Description>
  <rdf:Description rdf:about="urn:iwm:survey:2026-11-09:P40:pdf">
    <rdf:type rdf:resource="http://www.zotero.org/namespaces/export#Attachment" />
    <z:itemType>attachment</z:itemType>

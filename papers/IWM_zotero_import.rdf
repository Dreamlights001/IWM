  <rdf:Description rdf:about="urn:iwm:survey:2026-11-09:P28:note">
    <rdf:type rdf:resource="http://purl.org/net/biblio#Memo" />
    <rdf:value>&lt;h2&gt;P28 · Cosmos World Foundation Model Platform for Physical AI&lt;/h2&gt;&lt;p&gt;&lt;strong&gt;贡献：&lt;/strong&gt; Cosmos 提供视频数据清洗、tokenizer、世界基础模型和后训练流程。&lt;/p&gt;&lt;p&gt;&lt;strong&gt;论文证据范围：&lt;/strong&gt; 多类 Physical AI 视频生成与定制示例。&lt;/p&gt;&lt;p&gt;&lt;strong&gt;工厂迁移边界（本报告分析）：&lt;/strong&gt; 通用视频先验仍需用设备观测／动作后训练，具体许可证需按发布版本检查。&lt;/p&gt;&lt;p&gt;&lt;strong&gt;阅读定位：&lt;/strong&gt; 摘要；Platform；post-training&lt;/p&gt;&lt;p&gt;调研日：2026-11-09；报告未复现论文实验。归档版本：v3。来源：https://arxiv.org/abs/2501.03575&lt;/p&gt;&lt;p&gt;固定版本 PDF：https://arxiv.org/pdf/2501.03575v3；SHA-256：c3c61f0a6f9a32700fc47d9898db573628d72bdea07562ca319ceba046e95c84&lt;/p&gt;</rdf:value>
  </rdf:Description>
  <rdf:Description rdf:about="urn:iwm:survey:2026-11-09:P28:pdf">

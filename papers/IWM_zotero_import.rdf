  <rdf:Description rdf:about="urn:iwm:survey:2026-11-09:P45:note">
    <rdf:type rdf:resource="http://purl.org/net/biblio#Memo" />
    <rdf:value>&lt;h2&gt;P45 · iVideoGPT: Interactive VideoGPTs are Scalable World Models&lt;/h2&gt;&lt;p&gt;&lt;strong&gt;贡献：&lt;/strong&gt; iVideoGPT 把视觉、动作、奖励组织成序列，通过压缩 token 和自回归预测构建交互模型。&lt;/p&gt;&lt;p&gt;&lt;strong&gt;论文证据范围：&lt;/strong&gt; 动作条件视频、视觉规划和模型式强化学习。&lt;/p&gt;&lt;p&gt;&lt;strong&gt;工厂迁移边界（本报告分析）：&lt;/strong&gt; 需区分无动作预训练检查点与动作条件后训练；视频 token 的误差会累积。&lt;/p&gt;&lt;p&gt;&lt;strong&gt;阅读定位：&lt;/strong&gt; 摘要；tokenization；downstream adaptation&lt;/p&gt;&lt;p&gt;调研日：2026-11-09；报告未复现论文实验。归档版本：v3。来源：https://arxiv.org/abs/2405.15223&lt;/p&gt;&lt;p&gt;固定版本 PDF：https://arxiv.org/pdf/2405.15223v3；SHA-256：e79681befb89de01b4ecbb1abe0f4fa15b60420fe195371f95dcc8b607251984&lt;/p&gt;</rdf:value>
  </rdf:Description>
  <rdf:Description rdf:about="urn:iwm:survey:2026-11-09:P45:pdf">

  <rdf:Description rdf:about="urn:iwm:survey:2026-11-09:P09:note">
    <rdf:type rdf:resource="http://purl.org/net/biblio#Memo" />
    <rdf:value>&lt;h2&gt;P09 · ManiSkill3: GPU Parallelized Robotics Simulation and Rendering for Generalizable Embodied AI&lt;/h2&gt;&lt;p&gt;&lt;strong&gt;贡献：&lt;/strong&gt; ManiSkill3 支持 GPU 并行物理、渲染及异构操作环境。&lt;/p&gt;&lt;p&gt;&lt;strong&gt;论文证据范围：&lt;/strong&gt; 多种操作任务、示范生成和学习基线。&lt;/p&gt;&lt;p&gt;&lt;strong&gt;工厂迁移边界（本报告分析）：&lt;/strong&gt; 论文吞吐量受任务、传感器和硬件设定约束，不能直接换算全厂吞吐。&lt;/p&gt;&lt;p&gt;&lt;strong&gt;阅读定位：&lt;/strong&gt; 摘要；架构；性能基准&lt;/p&gt;&lt;p&gt;调研日：2026-11-09；报告未复现论文实验。归档版本：v2。来源：https://arxiv.org/abs/2410.00425&lt;/p&gt;&lt;p&gt;固定版本 PDF：https://arxiv.org/pdf/2410.00425v2；SHA-256：0482cef460af5ca0dd09d2b1d0f499b996287d9dadec31b13ca60377a49ee80c&lt;/p&gt;</rdf:value>
  </rdf:Description>
  <rdf:Description rdf:about="urn:iwm:survey:2026-11-09:P09:pdf">

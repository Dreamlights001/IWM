  <rdf:Description rdf:about="urn:iwm:survey:2026-11-09:P27:note">
    <rdf:type rdf:resource="http://purl.org/net/biblio#Memo" />
    <rdf:value>&lt;h2&gt;P27 · ArtiTwinSplat: Interactable Digital Twin Reconstruction via Gaussian Splatting from RGB-D videos&lt;/h2&gt;&lt;p&gt;&lt;strong&gt;贡献：&lt;/strong&gt; ArtiTwinSplat 从 RGB-D 视频恢复部件、关节及可交互高斯孪生，亦生成 URDF。&lt;/p&gt;&lt;p&gt;&lt;strong&gt;论文证据范围：&lt;/strong&gt; 真实关节对象；ICRA 2026 相关 workshop 工作。&lt;/p&gt;&lt;p&gt;&lt;strong&gt;工厂迁移边界（本报告分析）：&lt;/strong&gt; 小运动、低纹理、遮挡内表面及薄结构深度噪声仍有局限；非加工功能验证。&lt;/p&gt;&lt;p&gt;&lt;strong&gt;阅读定位：&lt;/strong&gt; 摘要；Limitations and Future Work&lt;/p&gt;&lt;p&gt;调研日：2026-11-09；报告未复现论文实验。归档版本：v1。来源：https://arxiv.org/abs/2606.24628&lt;/p&gt;&lt;p&gt;固定版本 PDF：https://arxiv.org/pdf/2606.24628v1；SHA-256：8454590816561c12925ec38c34aa59b304ce6180e4c2e395a5279900ddad4efa&lt;/p&gt;</rdf:value>
  </rdf:Description>
  <rdf:Description rdf:about="urn:iwm:survey:2026-11-09:P27:pdf">

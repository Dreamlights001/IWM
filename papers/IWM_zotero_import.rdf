  <rdf:Description rdf:about="urn:iwm:survey:2026-11-09:P36:note">
    <rdf:type rdf:resource="http://purl.org/net/biblio#Memo" />
    <rdf:value>&lt;h2&gt;P36 · VGGT: Visual Geometry Grounded Transformer&lt;/h2&gt;&lt;p&gt;&lt;strong&gt;贡献：&lt;/strong&gt; VGGT 前馈预测相机、深度、点图与点轨迹。&lt;/p&gt;&lt;p&gt;&lt;strong&gt;论文证据范围：&lt;/strong&gt; 多类几何任务和下游跟踪／新视图应用。&lt;/p&gt;&lt;p&gt;&lt;strong&gt;工厂迁移边界（本报告分析）：&lt;/strong&gt; 几何初始化能力与机床控制能力不同；绝对坐标与精度需外部基准验证。&lt;/p&gt;&lt;p&gt;&lt;strong&gt;阅读定位：&lt;/strong&gt; 摘要；任务定义与几何评测&lt;/p&gt;&lt;p&gt;调研日：2026-11-09；报告未复现论文实验。归档版本：v1。来源：https://arxiv.org/abs/2503.11651&lt;/p&gt;&lt;p&gt;固定版本 PDF：https://arxiv.org/pdf/2503.11651v1；SHA-256：5d7ab44d129172f39ef5918feb0014c4d041fd0e92f995d4dbbd7327a6e91d52&lt;/p&gt;</rdf:value>

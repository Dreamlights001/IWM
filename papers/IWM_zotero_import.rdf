  <rdf:Description rdf:about="urn:iwm:survey:2026-11-09:P32:note">
    <rdf:type rdf:resource="http://purl.org/net/biblio#Memo" />
    <rdf:value>&lt;h2&gt;P32 · Learning Mesh-Based Simulation with Graph Networks&lt;/h2&gt;&lt;p&gt;&lt;strong&gt;贡献：&lt;/strong&gt; MeshGraphNets 学习网格上的物理演化，可结合自适应离散化。&lt;/p&gt;&lt;p&gt;&lt;strong&gt;论文证据范围：&lt;/strong&gt; 空气动力、结构和布等科学模拟。&lt;/p&gt;&lt;p&gt;&lt;strong&gt;工厂迁移边界（本报告分析）：&lt;/strong&gt; 是局部过程代理模型的相关基础，未覆盖机床全工艺或全厂调度。&lt;/p&gt;&lt;p&gt;&lt;strong&gt;阅读定位：&lt;/strong&gt; 摘要；model / adaptive mesh 方法&lt;/p&gt;&lt;p&gt;调研日：2026-11-09；报告未复现论文实验。归档版本：v4。来源：https://arxiv.org/abs/2010.03409&lt;/p&gt;&lt;p&gt;固定版本 PDF：https://arxiv.org/pdf/2010.03409v4；SHA-256：d5a9e09b4b8d559121bc67cbaa020fe61326cc8296637cb4dab4dc86d495f625&lt;/p&gt;</rdf:value>
  </rdf:Description>
  <rdf:Description rdf:about="urn:iwm:survey:2026-11-09:P32:pdf">
    <rdf:type rdf:resource="http://www.zotero.org/namespaces/export#Attachment" />

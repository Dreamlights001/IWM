  <rdf:Description rdf:about="urn:iwm:survey:2026-11-09:P44:note">
    <rdf:type rdf:resource="http://purl.org/net/biblio#Memo" />
    <rdf:value>&lt;h2&gt;P44 · PointWorld: Scaling 3D World Models for In-The-Wild Robotic Manipulation&lt;/h2&gt;&lt;p&gt;&lt;strong&gt;贡献：&lt;/strong&gt; PointWorld 将状态与动作统一为三维点流，预测动作引起的场景位移。&lt;/p&gt;&lt;p&gt;&lt;strong&gt;论文证据范围：&lt;/strong&gt; 真实／仿真混合机器人数据；实机推物、关节物、可变形物及工具操作。&lt;/p&gt;&lt;p&gt;&lt;strong&gt;工厂迁移边界（本报告分析）：&lt;/strong&gt; 点流预测是动作条件几何动力学，不保证恢复封闭机床内部状态或材料去除机理。&lt;/p&gt;&lt;p&gt;&lt;strong&gt;阅读定位：&lt;/strong&gt; 摘要；action representation；MPC / real-world 实验&lt;/p&gt;&lt;p&gt;调研日：2026-11-09；报告未复现论文实验。归档版本：v1。来源：https://arxiv.org/abs/2601.03782&lt;/p&gt;&lt;p&gt;固定版本 PDF：https://arxiv.org/pdf/2601.03782v1；SHA-256：368ee87a0aeb2b784026d4eb0bd47e38937759473a2762f0ac338f9ad06a4b08&lt;/p&gt;</rdf:value>

    <z:path rdf:resource="file:///home/dlts/%E5%B7%A5%E4%B8%9A%E4%B8%96%E7%95%8C%E6%A8%A1%E5%9E%8B/papers/P14_URDFormer_2405.11656v3.pdf" />

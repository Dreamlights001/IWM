  <rdf:Description rdf:about="urn:iwm:survey:2026-11-09:P43:note">
    <rdf:type rdf:resource="http://purl.org/net/biblio#Memo" />
    <rdf:value>&lt;h2&gt;P43 · Learning Interactive Real-World Simulators&lt;/h2&gt;&lt;p&gt;&lt;strong&gt;贡献：&lt;/strong&gt; UniSim 混合多源数据，学习响应高层指令和低层控制的视觉交互模拟器。&lt;/p&gt;&lt;p&gt;&lt;strong&gt;论文证据范围：&lt;/strong&gt; 生成交互、在学得模拟器中训练策略及实机迁移案例。&lt;/p&gt;&lt;p&gt;&lt;strong&gt;工厂迁移边界（本报告分析）：&lt;/strong&gt; 显示视频生成可用于决策；仍缺全厂持久状态、互锁与生产质量的共同验证。&lt;/p&gt;&lt;p&gt;&lt;strong&gt;阅读定位：&lt;/strong&gt; 摘要；data mixture；robot learning 实验&lt;/p&gt;&lt;p&gt;调研日：2026-11-09；报告未复现论文实验。归档版本：v3。来源：https://arxiv.org/abs/2310.06114&lt;/p&gt;&lt;p&gt;固定版本 PDF：https://arxiv.org/pdf/2310.06114v3；SHA-256：956d21809f36cc107c82b3a32177ea555cacf032b3bde014fed1b958bc09c295&lt;/p&gt;</rdf:value>
  </rdf:Description>
  <rdf:Description rdf:about="urn:iwm:survey:2026-11-09:P43:pdf">
    <rdf:type rdf:resource="http://www.zotero.org/namespaces/export#Attachment" />

  <rdf:Description rdf:about="urn:iwm:survey:2026-11-09:P14:note">
    <rdf:type rdf:resource="http://purl.org/net/biblio#Memo" />
    <rdf:value>&lt;h2&gt;P14 · URDFormer: A Pipeline for Constructing Articulated Simulation Environments from Real-World Images&lt;/h2&gt;&lt;p&gt;&lt;strong&gt;贡献：&lt;/strong&gt; URDFormer 从图像和部件框预测分层 URDF，生成可交互仿真内容。&lt;/p&gt;&lt;p&gt;&lt;strong&gt;论文证据范围：&lt;/strong&gt; 柜体、抽屉等物体及 real-to-sim-to-real 操作。&lt;/p&gt;&lt;p&gt;&lt;strong&gt;工厂迁移边界（本报告分析）：&lt;/strong&gt; 依赖部件检测和预定义网格；不预测质量与摩擦等物理参数。&lt;/p&gt;&lt;p&gt;&lt;strong&gt;阅读定位：&lt;/strong&gt; §VI；Appendix F；项目页 Limitations&lt;/p&gt;&lt;p&gt;调研日：2026-11-09；报告未复现论文实验。归档版本：v3。来源：https://arxiv.org/abs/2405.11656&lt;/p&gt;&lt;p&gt;固定版本 PDF：https://arxiv.org/pdf/2405.11656v3；SHA-256：2add59f2e2691afd9f8b72f135657e50d1a197fea7ebc31a0611ad79970ddc88&lt;/p&gt;</rdf:value>
  </rdf:Description>
  <rdf:Description rdf:about="urn:iwm:survey:2026-11-09:P14:pdf">

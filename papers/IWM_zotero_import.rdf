  <rdf:Description rdf:about="urn:iwm:survey:2026-11-09:P35:note">
    <rdf:type rdf:resource="http://purl.org/net/biblio#Memo" />
    <rdf:value>&lt;h2&gt;P35 · DUSt3R: Geometric 3D Vision Made Easy&lt;/h2&gt;&lt;p&gt;&lt;strong&gt;贡献：&lt;/strong&gt; DUSt3R 从图像对回归点图，并通过全局对齐构建三维几何。&lt;/p&gt;&lt;p&gt;&lt;strong&gt;论文证据范围：&lt;/strong&gt; 深度、相机与多视图重建基准。&lt;/p&gt;&lt;p&gt;&lt;strong&gt;工厂迁移边界（本报告分析）：&lt;/strong&gt; 免预先标定不代表工业计量级绝对尺度；资产身份、关节和动力学仍缺失。&lt;/p&gt;&lt;p&gt;&lt;strong&gt;阅读定位：&lt;/strong&gt; 摘要；pointmaps / global alignment&lt;/p&gt;&lt;p&gt;调研日：2026-11-09；报告未复现论文实验。归档版本：v3。来源：https://arxiv.org/abs/2312.14132&lt;/p&gt;&lt;p&gt;固定版本 PDF：https://arxiv.org/pdf/2312.14132v3；SHA-256：400fea3f874aed6a9570a0651a701c2a3c635dcfbc2159348e04e83013a0099a&lt;/p&gt;</rdf:value>
  </rdf:Description>
  <rdf:Description rdf:about="urn:iwm:survey:2026-11-09:P35:pdf">

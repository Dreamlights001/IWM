  <rdf:Description rdf:about="urn:iwm:survey:2026-11-09:P16:note">
    <rdf:type rdf:resource="http://purl.org/net/biblio#Memo" />
    <rdf:value>&lt;h2&gt;P16 · 3D Gaussian Splatting for Real-Time Radiance Field Rendering&lt;/h2&gt;&lt;p&gt;&lt;strong&gt;贡献：&lt;/strong&gt; 3DGS 用可优化的各向异性三维高斯进行多视角新视图合成。&lt;/p&gt;&lt;p&gt;&lt;strong&gt;论文证据范围：&lt;/strong&gt; 静态场景的渲染质量、训练与显示效率。&lt;/p&gt;&lt;p&gt;&lt;strong&gt;工厂迁移边界（本报告分析）：&lt;/strong&gt; 高斯的协方差是渲染支持域；默认不代表实体碰撞边界、质量或机械应力。&lt;/p&gt;&lt;p&gt;&lt;strong&gt;阅读定位：&lt;/strong&gt; §3；表示与光栅化方法&lt;/p&gt;&lt;p&gt;调研日：2026-11-09；报告未复现论文实验。归档版本：v1。来源：https://arxiv.org/abs/2308.04079&lt;/p&gt;&lt;p&gt;固定版本 PDF：https://arxiv.org/pdf/2308.04079v1；SHA-256：f4c0c9f27e2d02b0265017f66049d471eb66cb50203bc918f51ba07d20cbbe11&lt;/p&gt;</rdf:value>
  </rdf:Description>
  <rdf:Description rdf:about="urn:iwm:survey:2026-11-09:P16:pdf">

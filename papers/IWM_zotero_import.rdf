  <rdf:Description rdf:about="urn:iwm:survey:2026-11-09:P29:note">
    <rdf:type rdf:resource="http://purl.org/net/biblio#Memo" />
    <rdf:value>&lt;h2&gt;P29 · Cosmos 3: Omnimodal World Models for Physical AI&lt;/h2&gt;&lt;p&gt;&lt;strong&gt;贡献：&lt;/strong&gt; Cosmos 3 在统一 mixture-of-transformers 架构中结合文本、图像、视频、音频与动作。&lt;/p&gt;&lt;p&gt;&lt;strong&gt;论文证据范围：&lt;/strong&gt; 多模态理解、生成、正向／逆向动力学与机器人策略评测。&lt;/p&gt;&lt;p&gt;&lt;strong&gt;工厂迁移边界（本报告分析）：&lt;/strong&gt; 本报告不将通用基准成绩视为全厂闭环验证，也不假定所有模式共享同等控制精度。&lt;/p&gt;&lt;p&gt;&lt;strong&gt;阅读定位：&lt;/strong&gt; 摘要；Introduction；Forward Dynamics 相关实验&lt;/p&gt;&lt;p&gt;调研日：2026-11-09；报告未复现论文实验。归档版本：v4。来源：https://arxiv.org/abs/2606.02800&lt;/p&gt;&lt;p&gt;固定版本 PDF：https://arxiv.org/pdf/2606.02800v4；SHA-256：df058bd2447fbdd83d13fd63be60a8b0aceb00ef6e50ba428b0a6bdbbed64b8d&lt;/p&gt;</rdf:value>
  </rdf:Description>
  <rdf:Description rdf:about="urn:iwm:survey:2026-11-09:P29:pdf">
    <rdf:type rdf:resource="http://www.zotero.org/namespaces/export#Attachment" />
    <z:itemType>attachment</z:itemType>

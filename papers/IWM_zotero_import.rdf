  <rdf:Description rdf:about="urn:iwm:survey:2026-11-09:P24:note">
    <rdf:type rdf:resource="http://purl.org/net/biblio#Memo" />
    <rdf:value>&lt;h2&gt;P24 · ManiGaussian: Dynamic Gaussian Splatting for Multi-task Robotic Manipulation&lt;/h2&gt;&lt;p&gt;&lt;strong&gt;贡献：&lt;/strong&gt; ManiGaussian 用未来高斯场景重建为操作策略提供动力学相关监督。&lt;/p&gt;&lt;p&gt;&lt;strong&gt;论文证据范围：&lt;/strong&gt; 10 个 RLBench 任务、166 个变化。&lt;/p&gt;&lt;p&gt;&lt;strong&gt;工厂迁移边界（本报告分析）：&lt;/strong&gt; 策略中的预测式辅助学习不等于任意动作查询的通用物理仿真器。&lt;/p&gt;&lt;p&gt;&lt;strong&gt;阅读定位：&lt;/strong&gt; 摘要；Gaussian world model；RLBench 实验&lt;/p&gt;&lt;p&gt;调研日：2026-11-09；报告未复现论文实验。归档版本：v2。来源：https://arxiv.org/abs/2403.08321&lt;/p&gt;&lt;p&gt;固定版本 PDF：https://arxiv.org/pdf/2403.08321v2；SHA-256：b38311f0229d7589fbebd08629ab0ae6d37e652283476a0f506ef729fb290f5d&lt;/p&gt;</rdf:value>

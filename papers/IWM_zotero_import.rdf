  <rdf:Description rdf:about="urn:iwm:survey:2026-11-09:P19:note">
    <rdf:type rdf:resource="http://purl.org/net/biblio#Memo" />
    <rdf:value>&lt;h2&gt;P19 · PhysGaussian: Physics-Integrated 3D Gaussians for Generative Dynamics&lt;/h2&gt;&lt;p&gt;&lt;strong&gt;贡献：&lt;/strong&gt; PhysGaussian 将连续介质动力学与 MPM 更新耦合到高斯表示。&lt;/p&gt;&lt;p&gt;&lt;strong&gt;论文证据范围：&lt;/strong&gt; 多类材料的物理驱动运动合成。&lt;/p&gt;&lt;p&gt;&lt;strong&gt;工厂迁移边界（本报告分析）：&lt;/strong&gt; 证明高斯可以承载物理，而非普通 3DGS 自动具有物理；切削／热工艺需另建模型。&lt;/p&gt;&lt;p&gt;&lt;strong&gt;阅读定位：&lt;/strong&gt; 摘要；MPM / continuum mechanics 方法&lt;/p&gt;&lt;p&gt;调研日：2026-11-09；报告未复现论文实验。归档版本：v3。来源：https://arxiv.org/abs/2311.12198&lt;/p&gt;&lt;p&gt;固定版本 PDF：https://arxiv.org/pdf/2311.12198v3；SHA-256：95b0b94d80e3161396235dbc67d0e0b0877f62b41a90c9921652dca05671eb47&lt;/p&gt;</rdf:value>
  </rdf:Description>
  <rdf:Description rdf:about="urn:iwm:survey:2026-11-09:P19:pdf">

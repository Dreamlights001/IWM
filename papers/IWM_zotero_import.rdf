  <rdf:Description rdf:about="urn:iwm:survey:2026-11-09:P10:note">
    <rdf:type rdf:resource="http://purl.org/net/biblio#Memo" />
    <rdf:value>&lt;h2&gt;P10 · Isaac Lab: A GPU-Accelerated Simulation Framework for Multi-Modal Robot Learning&lt;/h2&gt;&lt;p&gt;&lt;strong&gt;贡献：&lt;/strong&gt; Isaac Lab 将物理、渲染、执行器、多频传感器与学习环境组织成模块。&lt;/p&gt;&lt;p&gt;&lt;strong&gt;论文证据范围：&lt;/strong&gt; 多机器人形态的移动、接触操作与示范学习案例。&lt;/p&gt;&lt;p&gt;&lt;strong&gt;工厂迁移边界（本报告分析）：&lt;/strong&gt; 框架不自带具体工厂的设备状态机、加工规律或 MES 数据语义。&lt;/p&gt;&lt;p&gt;&lt;strong&gt;阅读定位：&lt;/strong&gt; 摘要；simulation architecture / sensors&lt;/p&gt;&lt;p&gt;调研日：2026-11-09；报告未复现论文实验。归档版本：v1。来源：https://arxiv.org/abs/2511.04831&lt;/p&gt;&lt;p&gt;固定版本 PDF：https://arxiv.org/pdf/2511.04831v1；SHA-256：f5b454fe245cdb1c485fe48c302494d689d335d375cd730fe0344113772bc8fa&lt;/p&gt;</rdf:value>
  </rdf:Description>
  <rdf:Description rdf:about="urn:iwm:survey:2026-11-09:P10:pdf">
    <rdf:type rdf:resource="http://www.zotero.org/namespaces/export#Attachment" />

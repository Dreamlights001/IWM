    <z:citationKey>P31_Graph_Network_Simulator</z:citationKey>
    <z:repository>arXiv</z:repository>
    <z:archiveID>2002.09405v2</z:archiveID>
    <z:DOI>10.48550/arXiv.2002.09405</z:DOI>

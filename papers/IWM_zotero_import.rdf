    <z:archiveID>2503.11651v1</z:archiveID>
    <z:DOI>10.48550/arXiv.2503.11651</z:DOI>
    <bib:authors>
      <rdf:Seq>
        <rdf:li>
          <foaf:Person>
            <foaf:surname>Jianyuan</foaf:surname>

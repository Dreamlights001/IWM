  <rdf:Description rdf:about="urn:iwm:survey:2026-11-09:P20:note">
    <rdf:type rdf:resource="http://purl.org/net/biblio#Memo" />
    <rdf:value>&lt;h2&gt;P20 · Reconstruction and Simulation of Elastic Objects with Spring-Mass 3D Gaussians&lt;/h2&gt;&lt;p&gt;&lt;strong&gt;贡献：&lt;/strong&gt; Spring-Gaus 以弹簧质点模型驱动高斯，并从多视角视频拟合弹性动力学。&lt;/p&gt;&lt;p&gt;&lt;strong&gt;论文证据范围：&lt;/strong&gt; 合成及真实弹性物体，测试不同初态和环境参数。&lt;/p&gt;&lt;p&gt;&lt;strong&gt;工厂迁移边界（本报告分析）：&lt;/strong&gt; 对象级弹性假设不等价于机床刚性接触、摩擦滞回或材料去除过程。&lt;/p&gt;&lt;p&gt;&lt;strong&gt;阅读定位：&lt;/strong&gt; 摘要；模型与仿真实验&lt;/p&gt;&lt;p&gt;调研日：2026-11-09；报告未复现论文实验。归档版本：v3。来源：https://arxiv.org/abs/2403.09434&lt;/p&gt;&lt;p&gt;固定版本 PDF：https://arxiv.org/pdf/2403.09434v3；SHA-256：03d88ab0f14a191f371d98b53c43ad45cafd392cb653722b672fd582853eab4e&lt;/p&gt;</rdf:value>
  </rdf:Description>
